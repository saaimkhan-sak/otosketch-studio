{
  "name": "ai-oto-surgical-diagrammer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "VINEXT=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:static": "NEXT_OUTPUT=export next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sites": "pnpm build:sites && node --test tests/sites-rendered-html.node.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --ignore-snapshots",
    "evaluate:synthetic": "tsx scripts/evaluate-synthetic-corpus.ts",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:static": "node scripts/verify-static-export.mjs",
    "verify:static:runtime": "node scripts/verify-static-runtime.mjs",
    "verify:worker": "tsx scripts/verify-cloudflare-worker.ts",
    "verify:ollama": "tsx scripts/verify-ollama-extraction.ts",
    "verify:privacy": "node scripts/verify-privacy.mjs",
    "verify:providers": "node scripts/verify-optional-providers.mjs",
    "deploy:cloudflare-demo": "node scripts/deploy-cloudflare-demo.mjs",
    "deploy:cloudflare-demo:dry-run": "node scripts/deploy-cloudflare-demo.mjs --dry-run",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "deploy:pages": "wrangler pages deploy out --project-name ai-oto-surgical-diagrammer"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.5",
    "react-server-dom-webpack": "19.2.7",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
